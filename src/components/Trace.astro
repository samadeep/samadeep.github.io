---
// Post list drawn as a trace: one row per post, bar length = reading time.
import { fmtDate } from '../lib/site';
type Row = { href: string; title: string; description?: string; date: Date; minutes: number };
const { rows, animate = false, axis = true, scale: fixed } = Astro.props as { rows: Row[]; animate?: boolean; axis?: boolean; scale?: number };
const scale = fixed ?? Math.ceil(Math.max(10, ...rows.map((r) => r.minutes)) / 10) * 10;
---
<ol class:list={['trace', { animate }]}>
  {rows.map((r, i) => (
    <li>
      <a class="row" href={r.href}>
        <time datetime={fmtDate(r.date)}>{fmtDate(r.date)}</time>
        <span class="t">{r.title}</span>
        {r.description && <p class="d">{r.description}</p>}
        <span class="span" aria-label={`${r.minutes} minute read`}>
          <span class="bar-track"><span class="bar" style={`width:${(r.minutes / scale) * 100}%;--i:${i}`}></span></span>
          <span class="ms">{r.minutes} min</span>
        </span>
      </a>
    </li>
  ))}
</ol>
{axis && rows.length > 0 && <div class="axis" aria-hidden="true"><span>0</span><span>{scale / 2} min</span><span>{scale} min</span></div>}
