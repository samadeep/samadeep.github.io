# Light theme for ```d2 diagrams. Same class names in both themes: a diagram says what a box IS.
# Style: the Claude Code docs "Subagents vs Agent Teams" figure. Open-colour pastel role fills,
# thin near-black outlines, sans labels, titled grey panels, black arrows, grey loop-back lines.
vars: {
  d2-config: { theme-overrides: { B1: "#1e1e1e"; B2: "#1e1e1e"; N1: "#1e1e1e"; N2: "#1e1e1e"; N3: "#495057" } }
}
classes: {
  panel: { label.near: outside-top-center; style: { fill: "#e9ecef"; stroke: "#ffffff"; stroke-width: 2; border-radius: 16; font-color: "#1e1e1e"; font-size: 24; bold: false } }
  box: { style: { fill: "#ffffff"; stroke: "#1e1e1e"; stroke-width: 2; border-radius: 8; font-color: "#1e1e1e"; font-size: 15; bold: false } }
  main: { style: { fill: "#ffc9c9"; stroke: "#1e1e1e"; stroke-width: 2; border-radius: 8; font-color: "#1e1e1e"; font-size: 15; bold: false } }
  worker: { style: { fill: "#ffd8a8"; stroke: "#1e1e1e"; stroke-width: 2; border-radius: 8; font-color: "#1e1e1e"; font-size: 15; bold: false } }
  peer: { style: { fill: "#d0bfff"; stroke: "#1e1e1e"; stroke-width: 2; border-radius: 8; font-color: "#1e1e1e"; font-size: 15; bold: false } }
  shared: { style: { fill: "#a5d8ff"; stroke: "#1e1e1e"; stroke-width: 2; stroke-dash: 2; border-radius: 8; font-color: "#1e1e1e"; font-size: 15; bold: false } }
  result: { shape: circle; style: { fill: transparent; stroke: "#1e1e1e"; stroke-width: 2; stroke-dash: 2; font-color: "#1e1e1e"; font-size: 14; bold: false } }
  allow: { style: { fill: "#b2f2bb"; stroke: "#1e1e1e"; stroke-width: 2; border-radius: 8; font-color: "#1e1e1e"; font-size: 15; bold: false } }
  deny: { style: { fill: "#ffa8a8"; stroke: "#1e1e1e"; stroke-width: 2; border-radius: 8; font-color: "#1e1e1e"; font-size: 15; bold: false } }
  ask: { style: { fill: "#ffec99"; stroke: "#1e1e1e"; stroke-width: 2; border-radius: 8; font-color: "#1e1e1e"; font-size: 15; bold: false } }
  lost: { style: { stroke: "#e03131"; font-color: "#c92a2a"; stroke-dash: 4 } }
  good: { style: { stroke: "#2f9e44"; font-color: "#2b8a3e" } }
  muted: { style: { stroke: "#868e96"; font-color: "#495057" } }
  card: { label.near: top-left; icon.near: top-right; width: 300; style: { font-size: 16; bold: true } }
  body: { shape: text; style: { font-size: 13; font-color: "#343a40" } }
  note: { shape: text; style: { font-color: "#495057"; font-size: 14; italic: false } }
}
style.fill: transparent
(** -> **)[*]: { style: { font-size: 12; italic: false; stroke-width: 2 } }
(** <-> **)[*]: { style: { font-size: 12; italic: false; stroke-width: 2 } }
