# Dark theme for ```d2 diagrams. Same class names as light.d2: diagrams say what a box IS.
vars: {
  lost: "#f08a7a"
  good: "#6fcf97"
  d2-config: { theme-overrides: { B1: "#cfc9bc"; B2: "#cfc9bc"; N1: "#e8e4d3"; N2: "#cfc9bc"; N3: "#a9a69a" } }
}
classes: {
  panel: { label.near: top-center; style: { fill: "#1d2124"; stroke: "#4a5057"; border-radius: 14; font-color: "#e8e4d3"; font-size: 18; bold: true; font: mono } }
  main: { style: { fill: "#5a2a2c"; stroke: "#d9cfc4"; border-radius: 8; font-color: "#f4ede4"; stroke-width: 2; font: mono } }
  worker: { style: { fill: "#4a3412"; stroke: "#d9cfc4"; border-radius: 8; font-color: "#f4ede4"; stroke-width: 2; font: mono } }
  peer: { style: { fill: "#3f2f6e"; stroke: "#d9cfc4"; border-radius: 8; font-color: "#f4ede4"; stroke-width: 2; font: mono } }
  shared: { style: { fill: "#1d3a5a"; stroke: "#c9d6e6"; stroke-dash: 3; border-radius: 8; font-color: "#f4ede4"; stroke-width: 2; font: mono } }
  result: { shape: circle; style: { fill: transparent; stroke: "#e8e4d3"; stroke-dash: 2; font-color: "#e8e4d3"; stroke-width: 2; font: mono } }
  allow: { style: { fill: "#163a28"; stroke: "#6fcf97"; border-radius: 8; font-color: "#d7f5e3"; stroke-width: 2; font: mono } }
  deny: { style: { fill: "#4a1d18"; stroke: "#f08a7a"; border-radius: 8; font-color: "#ffd9d2"; stroke-width: 2; font: mono } }
  ask: { style: { fill: "#18304d"; stroke: "#7fb2f0"; border-radius: 8; font-color: "#dbe9fb"; stroke-width: 2; font: mono } }
  lost: { style: { stroke: "#f08a7a"; font-color: "#f08a7a"; stroke-dash: 4; font: mono } }
  good: { style: { stroke: "#6fcf97"; font-color: "#6fcf97"; font: mono } }
  card: { label.near: top-left; icon.near: top-right; width: 300; style: { font-size: 15; bold: true; font: mono } }
  body: { shape: text; style: { font-size: 12; font: mono; font-color: "#cfc9bc" } }
  note: { shape: text; style: { font-color: "#a9a69a"; font-size: 14; italic: false; font: mono } }
}
style.fill: transparent
(** -> **)[*]: { style: { font-size: 13; font: mono; italic: false; stroke-width: 2; font: mono } }
