# Dark theme for ```d2 diagrams. Same class names in both themes: a diagram says what a box IS.
# Style: the Claude Code docs "Subagents vs Agent Teams" figure. Open-colour pastel role fills,
# thin near-black outlines, sans labels, titled grey panels, black arrows, grey loop-back lines.
vars: {
  d2-config: { theme-overrides: { B1: "#d3d3d3"; B2: "#d3d3d3"; N1: "#d3d3d3"; N2: "#d3d3d3"; N3: "#adb5bd" } }
}
classes: {
  panel: { label.near: outside-top-center; style: { fill: "#202225"; stroke: "#111111"; stroke-width: 2; border-radius: 16; font-color: "#d3d3d3"; font-size: 24; bold: false } }
  box: { style: { fill: "#2c2f33"; stroke: "#d3d3d3"; stroke-width: 2; border-radius: 8; font-color: "#d3d3d3"; font-size: 15; bold: false } }
  main: { style: { fill: "#5b2c2c"; stroke: "#d3d3d3"; stroke-width: 2; border-radius: 8; font-color: "#d3d3d3"; font-size: 15; bold: false } }
  worker: { style: { fill: "#4c2a01"; stroke: "#d3d3d3"; stroke-width: 2; border-radius: 8; font-color: "#d3d3d3"; font-size: 15; bold: false } }
  peer: { style: { fill: "#483a71"; stroke: "#d3d3d3"; stroke-width: 2; border-radius: 8; font-color: "#d3d3d3"; font-size: 15; bold: false } }
  shared: { style: { fill: "#154163"; stroke: "#d3d3d3"; stroke-width: 2; stroke-dash: 2; border-radius: 8; font-color: "#d3d3d3"; font-size: 15; bold: false } }
  result: { shape: circle; style: { fill: transparent; stroke: "#d3d3d3"; stroke-width: 2; stroke-dash: 2; font-color: "#d3d3d3"; font-size: 14; bold: false } }
  allow: { style: { fill: "#1f4a2a"; stroke: "#d3d3d3"; stroke-width: 2; border-radius: 8; font-color: "#d3d3d3"; font-size: 15; bold: false } }
  deny: { style: { fill: "#6b2121"; stroke: "#d3d3d3"; stroke-width: 2; border-radius: 8; font-color: "#d3d3d3"; font-size: 15; bold: false } }
  ask: { style: { fill: "#4d4111"; stroke: "#d3d3d3"; stroke-width: 2; border-radius: 8; font-color: "#d3d3d3"; font-size: 15; bold: false } }
  lost: { style: { stroke: "#ff6b6b"; font-color: "#ff8787"; stroke-dash: 4 } }
  good: { style: { stroke: "#51cf66"; font-color: "#69db7c" } }
  muted: { style: { stroke: "#6f757c"; font-color: "#adb5bd" } }
  card: { label.near: top-left; icon.near: top-right; width: 300; style: { font-size: 16; bold: true } }
  body: { shape: text; style: { font-size: 13; font-color: "#c1c2c5" } }
  note: { shape: text; style: { font-color: "#adb5bd"; font-size: 14; italic: false } }
}
style.fill: transparent
(** -> **)[*]: { style: { font-size: 12; italic: false; stroke-width: 2 } }
(** <-> **)[*]: { style: { font-size: 12; italic: false; stroke-width: 2 } }
