---
// Writing: every post, filterable, grouped by year. ("Start here" lives on the home page.)
//   Filters      topic, "runs in your browser", "under 10 min" (client-side, mirrored in the URL)
//   List         one line per post: date, title, its one-line hook, series, topic, minutes, runnable count
import Icon from '../../components/Icon.astro';
import Sidebar from '../../components/Sidebar.astro';
import Base from '../../layouts/Base.astro';
import { getPosts, topicGroups } from '../../lib/posts';
import { TOPICS } from '../../lib/topics';
import { seriesOf, seriesWords } from '../../lib/series';

const posts = await getPosts();
const groups = topicGroups(posts);
const runs = (p: { body?: string; data: { vm?: unknown } }) => (p.data.vm ? (p.body?.match(/^```(bash|python)\b/gm) ?? []).length : 0); // Run buttons exist only on posts with a VM
const topicOf = (slug: string) => TOPICS.find((t) => t.slug === slug)!;
const fmt = (d: Date) => d.toLocaleDateString('en', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
const QUICK = 10;
---
<Base title="Writing" description="Engineering posts on systems, low latency, AI infrastructure and algorithms. Most commands run in your browser.">
  <div class="wrap wide with-rail">
  <div class="main-col writing">
    <header class="page-head">
      <h1>Writing</h1>
      <p>{posts.length} posts, newest first. Filter by topic, or browse <a href="/series/">the series</a>.</p>
    </header>

    <div class="wfilter" role="group" aria-label="Filter posts">
      <div class="wf-topics">
        <button type="button" class="chip" data-topic="" aria-pressed="true">All</button>
        {groups.map((g) => <button type="button" class="chip" data-topic={g.slug} aria-pressed="false"><Icon name={g.icon} />{g.name}<span class="n">{g.posts.length}</span></button>)}
      </div>
      <div class="wf-toggles">
        <button type="button" class="chip" data-flag="run" aria-pressed="false"><Icon name="zap" />Runs in your browser</button>
        <button type="button" class="chip" data-flag="quick" aria-pressed="false"><Icon name="clock" />Under {QUICK} min</button>
      </div>
    </div>
    <p class="wf-count" aria-live="polite"></p>

    {years.map((y) => (
      <section class="wyear" data-year={y}>
        <h2 class="eyebrow">{y}</h2>
        <ol class="wlist">
          {posts.filter((p) => p.data.date.getUTCFullYear() === y).map((p) => {
            const t = topicOf(p.data.topic);
            const n = runs(p);
            const s = p.data.series ? seriesOf(p.data.series) : undefined;
            return (
              <li class="wl" data-topic={t.slug} data-run={n > 0 ? '1' : '0'} data-quick={p.minutes < QUICK ? '1' : '0'}>
                <time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}</time>
                <div class="wl-body">
                  <a class="wl-title" href={p.href}>{p.data.title}</a>
                  <p class="wl-why">{p.data.hook ? <><b>{p.data.hook.stat}</b> {p.data.hook.caption}</> : p.data.description}</p>
                  <p class="wl-meta">
                    {s && <a class="wl-series" href={`/series/${s.slug}/`}><Icon name={s.icon} />{seriesWords(s).label(p.issue!)}</a>}
                    <span class="wl-topic">{t.name}</span>
                    <span>{p.minutes} min</span>
                    {n > 0 && <span class="run"><Icon name="zap" />{n} runnable</span>}
                  </p>
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
    <p class="wf-empty" hidden>Nothing matches yet. <button type="button" class="linkish" data-reset>Clear filters</button></p>
    <p class="wf-more"><a href="/tags/">Browse by tag</a> · <a href="/feed.xml">RSS</a></p>
  </div>
  <Sidebar hrefFor={(s: string) => `/topics/${s}/`} />
  </div>

  <script>
    const root = document.querySelector<HTMLElement>('.writing');
    if (root) {
      const items = [...root.querySelectorAll<HTMLElement>('.wl')];
      const topicBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-topic]')].filter((b) => b.tagName === 'BUTTON');
      const flagBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-flag]')];
      const count = root.querySelector<HTMLElement>('.wf-count')!;
      const empty = root.querySelector<HTMLElement>('.wf-empty')!;
      const state = { topic: '', run: false, quick: false };
      const read = () => {
        const q = new URLSearchParams(location.search);
        state.topic = q.get('topic') ?? ''; state.run = q.has('run'); state.quick = q.has('quick');
      };
      const write = () => {
        const q = new URLSearchParams();
        if (state.topic) q.set('topic', state.topic);
        if (state.run) q.set('run', '');
        if (state.quick) q.set('quick', '');
        const s = q.toString().replace(/=(&|$)/g, '$1');
        history.replaceState(null, '', s ? `?${s}` : location.pathname);
      };
      const apply = () => {
        let shown = 0;
        for (const li of items) {
          const ok = (!state.topic || li.dataset.topic === state.topic) && (!state.run || li.dataset.run === '1') && (!state.quick || li.dataset.quick === '1');
          li.hidden = !ok; if (ok) shown++;
        }
        root.querySelectorAll<HTMLElement>('.wyear').forEach((s) => { s.hidden = !s.querySelector('.wl:not([hidden])'); });
        topicBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.topic === state.topic)));
        flagBtns.forEach((b) => b.setAttribute('aria-pressed', String(state[b.dataset.flag as 'run' | 'quick'])));
        const filtered = state.topic || state.run || state.quick;
        count.textContent = filtered ? `Showing ${shown} of ${items.length}` : '';
        empty.hidden = shown > 0;
      };
      topicBtns.forEach((b) => b.addEventListener('click', () => { state.topic = b.dataset.topic ?? ''; write(); apply(); }));
      flagBtns.forEach((b) => b.addEventListener('click', () => { const k = b.dataset.flag as 'run' | 'quick'; state[k] = !state[k]; write(); apply(); }));
      root.querySelector('[data-reset]')?.addEventListener('click', () => { state.topic = ''; state.run = state.quick = false; write(); apply(); });
      read(); apply();
    }
  </script>
</Base>
