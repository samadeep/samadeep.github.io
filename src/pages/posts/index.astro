---
import Base from '../../layouts/Base.astro';
import Trace from '../../components/Trace.astro';
import { getPosts, toRow, tagCounts } from '../../lib/posts';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
const scale = Math.ceil(Math.max(10, ...posts.map((p) => p.minutes)) / 10) * 10;
const tags = tagCounts(posts).slice(0, 14);
---
<Base title="Writing" description="Every post, newest first.">
  <div class="wrap">
    <header class="page-head">
      <h1>Writing</h1>
      <p>{posts.length} posts on systems, latency and algorithms. Bars show reading time.</p>
    </header>
    <ul class="tag-cloud">{tags.map(([t, n]) => <li><a href={`/tags/${t}/`}>{t}<span class="n">{n}</span></a></li>)}<li><a href="/tags/">All tags</a></li></ul>
    {years.map((y) => (
      <>
        <h2 class="year">{y}</h2>
        <Trace rows={posts.filter((p) => p.data.date.getUTCFullYear() === y).map((p) => toRow(p))} axis={false} scale={scale} />
      </>
    ))}
  </div>
</Base>
