---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
import { topicOf } from '../../lib/topics';
import { seriesOf, seriesWords } from '../../lib/series';
import { SITE, fmtDate } from '../../lib/site';
import Icon from '../../components/Icon.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import Reactions from '../../components/Reactions.astro';

export async function getStaticPaths() {
  const posts = await getPosts();
  // prev/next stay inside the post's series (else its topic), so a reader keeps reading what they came for
  return posts.map((post) => {
    const same = posts.filter((p) => (post.data.series ? p.data.series === post.data.series : p.data.topic === post.data.topic));
    const i = same.indexOf(post);
    return { params: { slug: post.id }, props: { post, newer: same[i - 1], older: same[i + 1], issues: post.data.series ? same : [] } };
  });
}

const { post, newer, older, issues } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const { title, description, date, updated, tags, problems } = post.data;
const hasMath = post.body?.includes('$$') ?? false; // KaTeX's stylesheet only where there is math
const topic = topicOf(post.data.topic);
const series = post.data.series ? seriesOf(post.data.series) : undefined;
const words = series ? seriesWords(series) : undefined;
const olderLabel = words ? words.prev : `Older in ${topic.name}`;
const newerLabel = words ? words.next : `Newer in ${topic.name}`;
const runnable = post.data.vm ? (post.body?.match(/^```(bash|python)\b/gm) ?? []).length : 0; // Run buttons need the VM
const source = `${SITE.repo}/blob/main/src/content/posts/${post.filePath?.split('/').pop()}`;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description,
  ...(series && { isPartOf: { '@type': 'CreativeWorkSeries', name: series.name, url: new URL(`/series/${series.slug}/`, SITE.url).href }, position: post.issue }),
  datePublished: date.toISOString(), dateModified: (updated ?? date).toISOString(),
  author: { '@type': 'Person', name: SITE.name, url: SITE.url },
  image: new URL(`/og/${post.id}.png`, SITE.url).href, keywords: tags.join(', '),
};
---
<Base title={title} description={description} type="article" published={date} image={`/og/${post.id}.png`}>
  {hasMath && <link slot="head" rel="stylesheet" href="/vendor/katex/katex.min.css" />}
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="read-progress" aria-hidden="true"></div>
  <a class="to-top" href="#top" aria-label="Back to top" hidden>
    <svg viewBox="0 0 44 44" aria-hidden="true"><circle class="ring-bg" cx="22" cy="22" r="20"/><circle class="ring" cx="22" cy="22" r="20" pathLength="100"/><path d="M22 29V15m-6 6 6-6 6 6"/></svg>
  </a>
  <div class="wrap wide">
    <div class="post-layout">
      <article data-pagefind-body data-pagefind-filter="kind:Writing" data-vm-setup={post.data.vm?.setup}>
        <header class="post-head">
          <p class="kicker">
            <a class="topic-link" href={`/topics/${topic.slug}/`} data-pagefind-filter="topic" data-pagefind-meta="topic"><Icon name={topic.icon} />{topic.name}</a>
            {tags.slice(0, 3).map((t) => <a class="kick-tag" href={`/tags/${t}/`} data-pagefind-ignore>{t}</a>)}
          </p>
          <h1 style={`view-transition-name:post-${post.id}`}>{title}</h1>
          <p class="lede">{description}</p>
          <div class="byline">
            <span class="by-mark" aria-hidden="true">S</span>
            <span class="by-name"><a href="/about/">{SITE.name}</a></span>
            <span class="by-sep" aria-hidden="true">·</span>
            <time datetime={fmtDate(date)} data-pagefind-meta="date">{date.toLocaleDateString('en', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>
            <span class="by-sep" aria-hidden="true">·</span>
            <span><span data-pagefind-meta="minutes">{post.minutes} min read</span></span>
            {runnable > 0 && <span class="by-run"><Icon name="zap" />{runnable} commands run in your browser</span>}
          </div>
        </header>

        {series && (
          <nav class="series-strip" style={`--hue:${series.hue}`} aria-label={`${series.name}, all posts`} data-pagefind-ignore>
            <a class="ss-name" href={`/series/${series.slug}/`}><span class="ss-kick">Series</span>{series.name}</a>
            <span class="ss-of">{words!.unit} {post.issue} of {issues.length}</span>
            <ol class="ss-issues">
              {[...issues].reverse().map((p) => (
                <li><a href={p.href} title={p.data.title} aria-current={p === post ? 'page' : undefined}>{p.issue}</a></li>
              ))}
            </ol>
          </nav>
        )}

        {problems.length > 0 && (
          <ul class="problems" aria-label="Problems in this post" data-pagefind-ignore>
            {problems.map((pr) => (
              <li><a href={pr.url} rel="noopener">
                <span class="pf">{pr.platform} {pr.id}</span><span class="pt">{pr.title}</span>{pr.difficulty && <span class="pd">{pr.difficulty}</span>}
              </a></li>
            ))}
          </ul>
        )}

        {toc.length > 2 && (
          <details class="toc-inline" data-pagefind-ignore>
            <summary>Contents</summary>
            <ol>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </details>
        )}

        <div class="prose"><Content /></div>

        <AuthorCard title={title} topic={topic.slug} />

        <Reactions />

        <p class="edit" data-pagefind-ignore>Spotted a mistake? <a href={source}>Suggest an edit on GitHub</a>.</p>

        {(newer || older) && (
          <nav class="post-foot" aria-label="More posts" data-pagefind-ignore>
            {older && <a href={older.href}><small>{olderLabel}</small>{older.data.title}</a>}
            {newer && <a class="next" href={newer.href}><small>{newerLabel}</small>{newer.data.title}</a>}
          </nav>
        )}
      </article>

      {toc.length > 2 && (
        <aside class="toc-rail" data-pagefind-ignore>
          <nav class="toc" aria-label="On this page">
            <h2>On this page</h2>
            <ol>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        </aside>
      )}
    </div>
  </div>

  <script>
    import '../../scripts/labs';
    import '../../scripts/vm';
    // highlight the section currently in view
    const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    if (links.size) {
      let current: HTMLAnchorElement | undefined;
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) {
          current?.classList.remove('active');
          current = links.get(e.target.id);
          current?.classList.add('active');
        }
      }, { rootMargin: '0px 0px -75% 0px' });
      links.forEach((_, id) => { const h = document.getElementById(id); if (h) io.observe(h); });
    }

    // every section heading gets a link icon; clicking it copies the section's URL
    for (const h of document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')) {
      const a = document.createElement('a');
      a.className = 'h-anchor'; a.href = `#${h.id}`; a.setAttribute('aria-label', `Copy link to "${h.textContent}"`);
      a.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>';
      a.addEventListener('click', async (e) => {
        e.preventDefault();
        history.replaceState(null, '', a.hash);
        h.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        try { await navigator.clipboard.writeText(location.href); a.dataset.copied = ''; setTimeout(() => delete a.dataset.copied, 1400); } catch { /* clipboard blocked: the hash is still set */ }
      });
      h.prepend(a);
    }

    // folded solution steps: one button opens or closes all of them
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-reveal-all]')) {
      const steps = [...document.querySelectorAll<HTMLDetailsElement>('.prose details.step')];
      b.addEventListener('click', () => {
        const open = !steps.every((d) => d.open);
        steps.forEach((d) => (d.open = open));
        b.textContent = open ? 'Fold every step' : 'Open every step';
      });
    }
    // a link to something inside a folded step opens it
    const openTarget = () => { const t = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null; t?.closest('details')?.setAttribute('open', ''); };
    addEventListener('hashchange', openTarget); openTarget();

    // back to top: appears after the first screen, its ring fills as you read
    const top = document.querySelector<HTMLAnchorElement>('.to-top');
    if (top) {
      const ring = top.querySelector<SVGCircleElement>('.ring')!;
      let raf = 0;
      const update = () => {
        raf = 0;
        const max = document.documentElement.scrollHeight - innerHeight;
        const f = max > 0 ? Math.min(1, scrollY / max) : 0;
        ring.style.strokeDashoffset = String(100 - f * 100);
        top.hidden = scrollY < innerHeight * 0.8;
      };
      addEventListener('scroll', () => { raf ||= requestAnimationFrame(update); }, { passive: true });
      update();
      top.addEventListener('click', (e) => { e.preventDefault(); scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); });
    }
  </script>
</Base>
