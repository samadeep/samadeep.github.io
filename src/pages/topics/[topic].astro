---
import Base from '../../layouts/Base.astro';
import FeedItem from '../../components/FeedItem.astro';
import { getPosts, tagCounts, topicGroups, readScale, postCard } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const groups = topicGroups(posts);
  return groups.map((g) => ({ params: { topic: g.slug }, props: { group: g, others: groups.filter((o) => o.slug !== g.slug), scale: readScale(posts) } }));
}
const { group, others, scale } = Astro.props;
const tags = tagCounts(group.posts);
---
<Base title={group.name} description={group.blurb}>
  <div class="wrap">
    <header class="page-head">
      <h1>{group.name}</h1>
      <p>{group.blurb}</p>
    </header>
    <ul class="feed">{group.posts.map((p) => <FeedItem {...postCard(p, scale)} />)}</ul>
    {tags.length > 0 && (
      <section class="topic">
        <div class="topic-head"><h2>Tags in {group.name}</h2></div>
        <ul class="tag-cloud">{tags.map(([t, n]) => <li><a href={`/tags/${t}/`}>{t}<span class="n">{n}</span></a></li>)}</ul>
      </section>
    )}
    {others.length > 0 && (
      <section class="topic">
        <div class="topic-head"><h2>Other topics</h2><a href="/posts/">All writing</a></div>
        <ul class="topic-jump">{others.map((o) => <li><a href={`/topics/${o.slug}/`}>{o.name}<span class="n">{o.posts.length}</span></a></li>)}</ul>
      </section>
    )}
  </div>
</Base>
