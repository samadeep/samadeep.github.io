---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Search from '../components/Search.astro';
import { SITE, ANALYTICS } from '../lib/site';

type Props = { title?: string; description?: string; image?: string; type?: 'website' | 'article'; published?: Date; noindex?: boolean };
const { title, description = SITE.description, image = '/og/site.png', type = 'website', published, noindex } = Astro.props as Props;
// articles use their own title: search results cut off around 60 characters
const fullTitle = !title ? SITE.name : type === 'article' ? title : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
const nav = [
  ['/posts/', 'Writing', 'pen-line'],
  ['/series/', 'Series', 'library'],
  ['/reading/', 'Reading', 'book-open'],
  ['/about/', 'About', 'user'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: writing`} href="/feed.xml" />
  <link rel="alternate" type="application/atom+xml" title={`${SITE.name}: reading list`} href="/reading.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#e8e4d3" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#031211" media="(prefers-color-scheme: dark)" />

  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title ?? SITE.name} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {published && <meta property="article:published_time" content={published.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@samadeepviews" />

  <!-- set theme before first paint: saved choice, else system -->
  <script is:inline>
    (() => {
      let t; try { t = localStorage.getItem('theme'); } catch {}
      if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = t;
    })();
  </script>
  <slot name="head" />
  {ANALYTICS.cloudflareToken && import.meta.env.PROD && (
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: ANALYTICS.cloudflareToken })}></script>
  )}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap wide">
      <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
        <svg class="mark" viewBox="0 0 32 32" aria-hidden="true"><path d="M8 10l6 6-6 6" fill="none" stroke="var(--trace-fill)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/><rect class="cursor" x="17" y="19" width="8" height="3.4" rx="1" fill="currentColor"/></svg>
        <span class="brand-name" data-text="Samadeep's blog" style="--chars:15">Samadeep's blog</span>
      </a>
      <nav class="nav" aria-label="Main">
        {nav.map(([href, label, icon]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}><Icon name={icon} />{label}</a>)}
      </nav>
      <button class="icon-btn search-btn" type="button" data-open-search aria-label="Search (Ctrl K)">
        <Icon name="search" /><span class="kbd">⌘K</span>
      </button>
      <button class="icon-btn" type="button" id="theme-toggle" aria-label="Switch colour theme">
        <span class="when-light"><Icon name="moon" /></span><span class="when-dark"><Icon name="sun" /></span>
      </button>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="site-foot">
    <div class="wrap wide">
      <span>© {new Date().getFullYear()} {SITE.name}</span>
      <span class="spacer"></span>
      {Object.entries(SITE.links).map(([k, v]) => <a href={v} rel="me noopener" aria-label={k} title={k}><Icon name={k.toLowerCase()} /></a>)}
      <a href="/feed.xml" aria-label="RSS feed" title="RSS"><Icon name="rss" /></a>
    </div>
  </footer>

  <Search />

  <style is:global>
    [data-theme='light'] .when-dark, [data-theme='dark'] .when-light { display: none; }
    .when-light, .when-dark { display: contents; }
    .brand .cursor { animation: blink 1.1s steps(1) infinite; }
    .brand:hover .cursor { animation: none; }
    @keyframes blink { 50% { opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .brand .cursor { animation: none; } }
  </style>
  <script>
    const root = document.documentElement;
    // theme switch: a circle of the new theme grows from the toggle (View Transitions), plain swap otherwise
    document.getElementById('theme-toggle')?.addEventListener('click', (e) => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      const apply = () => { root.dataset.theme = next; try { localStorage.setItem('theme', next); } catch {} };
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!document.startViewTransition || still) return apply();
      const b = (e.currentTarget as HTMLElement).getBoundingClientRect();
      const x = b.left + b.width / 2, y = b.top + b.height / 2;
      const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      root.classList.add('theme-vt');
      const t = document.startViewTransition(apply);
      t.ready.then(() => root.animate({ clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
        { duration: 450, easing: 'cubic-bezier(.2,.7,.2,1)', pseudoElement: '::view-transition-new(root)' }));
      t.finished.finally(() => root.classList.remove('theme-vt'));
    });

    // the name types itself on the home page, and on the first page of a visit elsewhere
    const name = document.querySelector<HTMLElement>('.brand-name');
    let seen = false; try { seen = sessionStorage.getItem('typed') === '1'; sessionStorage.setItem('typed', '1'); } catch {}
    if (name && (location.pathname === '/' || !seen) && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const text = name.dataset.text ?? name.textContent ?? '';
      name.textContent = ''; name.classList.add('typing');
      let at = 450;   // cumulative, so a pause after a space can't reorder letters
      [...text].forEach((ch, i) => { at += ch === ' ' ? 200 : 95; setTimeout(() => {
        name.textContent += ch;
        if (i === text.length - 1) setTimeout(() => name.classList.remove('typing'), 1200);
      }, at); });
    }

  </script>
</body>
</html>
