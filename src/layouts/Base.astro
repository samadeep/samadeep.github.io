---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site';

type Props = { title?: string; description?: string; image?: string; type?: 'website' | 'article'; published?: Date; noindex?: boolean };
const { title, description = SITE.description, image = '/og/site.png', type = 'website', published, noindex } = Astro.props as Props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
const nav = [
  ['/posts/', 'Writing'],
  ['/reading/', 'Reading'],
  ['/about/', 'About'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: writing`} href="/feed.xml" />
  <link rel="alternate" type="application/atom+xml" title={`${SITE.name}: reading list`} href="/reading.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#e8e4d3" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#031211" media="(prefers-color-scheme: dark)" />

  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title ?? SITE.name} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {published && <meta property="article:published_time" content={published.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@samadeepviews" />

  <!-- set theme before first paint: saved choice, else system -->
  <script is:inline>
    (() => {
      let t; try { t = localStorage.getItem('theme'); } catch {}
      if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = t;
    })();
  </script>
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap wide">
      <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
        <svg viewBox="0 0 32 32" aria-hidden="true"><g fill="var(--trace-fill)"><rect x="3" y="6" width="18" height="5" rx="1"/><rect x="9" y="14" width="20" height="5" rx="1"/><rect x="3" y="22" width="12" height="5" rx="1"/></g></svg>
        {SITE.name}
      </a>
      <nav class="nav" aria-label="Main">
        {nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <button class="icon-btn search-btn" type="button" data-open-search aria-label="Search (Ctrl K)">
        <Icon name="search" /><span class="kbd">⌘K</span>
      </button>
      <button class="icon-btn" type="button" id="theme-toggle" aria-label="Switch colour theme">
        <span class="when-light"><Icon name="moon" /></span><span class="when-dark"><Icon name="sun" /></span>
      </button>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="site-foot">
    <div class="wrap wide">
      <span>© {new Date().getFullYear()} {SITE.name}</span>
      <span class="spacer"></span>
      {Object.entries(SITE.links).map(([k, v]) => <a href={v} rel="me noopener">{k}</a>)}
      <a href="/feed.xml">RSS</a>
    </div>
  </footer>

  <dialog class="search" id="search" aria-label="Search the site">
    <div class="inner"><div id="search-ui"></div></div>
  </dialog>

  <style is:global>
    [data-theme='light'] .when-dark, [data-theme='dark'] .when-light { display: none; }
    .when-light, .when-dark { display: contents; }
  </style>
  <script>
    const root = document.documentElement;
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
    });

    // Pagefind UI, loaded only the first time search is opened
    const dlg = document.getElementById('search') as HTMLDialogElement;
    let loaded = false;
    async function openSearch() {
      if (!loaded) {
        loaded = true;
        const css = document.createElement('link');
        css.rel = 'stylesheet'; css.href = '/pagefind/pagefind-ui.css';
        document.head.append(css);
        try {
          await new Promise((ok, fail) => {
            const s = document.createElement('script');
            s.src = '/pagefind/pagefind-ui.js'; s.onload = ok; s.onerror = fail;
            document.head.append(s);
          });
          // @ts-ignore
          new window.PagefindUI({ element: '#search-ui', showSubResults: true, showImages: false, resetStyles: false });
        } catch {
          document.getElementById('search-ui')!.textContent = 'Search is built with the production site. Run npm run build, then npm run preview.';
        }
      }
      dlg.showModal();
      requestAnimationFrame(() => dlg.querySelector('input')?.focus());
    }
    document.querySelectorAll('[data-open-search]').forEach((b) => b.addEventListener('click', openSearch));
    addEventListener('keydown', (e) => {
      if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !(e.target as HTMLElement).closest('input,textarea,[contenteditable]'))) {
        e.preventDefault(); dlg.open ? dlg.close() : openSearch();
      }
    });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  </script>
</body>
</html>
